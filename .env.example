# LLM & research
OPENROUTER_API_KEY=
TAVILY_API_KEY=
FIRECRAWL_API_KEY=

# Supabase — PostgreSQL (SQLAlchemy + pgvector)
DATABASE_URL=postgresql+asyncpg://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Supabase — SDK (Storage; future Auth)
SUPABASE_URL=https://[ref].supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# API auth (leave empty for local dev without Bearer token)
HELMOS_API_KEY=dev-key

# Render (set in Render dashboard)
RENDER_EXTERNAL_URL=https://helmos-api.onrender.com

# Cost controls
DAILY_SPEND_CAP_USD=5.00
RESEARCH_MAX_PAGES_PER_SESSION=5

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-frontend.vercel.app
